# Optional local provider smoke test: npm run test:xon reads XON_API_KEY here.
# Copy to .env (ignored by Git), then supply the test key locally.
# This file and .env are NOT loaded by the Worker.
# No credentials are required for the M0 health endpoint.
# Future Worker secrets belong in apps/api/.dev.vars for local development.
# Keep all provider keys on the server, never in iOS configuration.
XON_API_KEY=
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_WEBHOOK_AUTHORIZATION=
# EMAIL_FROM=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# DATA_ENCRYPTION_KEY=
# EMAIL_BLIND_INDEX_KEY=
