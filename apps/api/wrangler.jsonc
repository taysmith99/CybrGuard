{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cybrguard-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false,
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "APP_ENV": "development",
    "DATA_MODE": "unconfigured"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cybrguard-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "cybrguard-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.cybrguard.app",
          "custom_domain": true,
          "zone_name": "cybrguard.app"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "DATA_MODE": "live",
        "EMAIL_TRANSPORT": "cloudflare-rest",
        "EMAIL_FROM": "security@cybrguard.app",
        "CLOUDFLARE_ACCOUNT_ID": "9e107262ea2871d9315290c7e380a2da"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cybrguard-staging",
          "database_id": "699a6bb1-4991-4d7e-9bc3-5104697b9a61",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "MONITORING_QUEUE",
            "queue": "cybrguard-monitoring-staging"
          }
        ],
        "consumers": [
          {
            "queue": "cybrguard-monitoring-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "max_concurrency": 1,
            "retry_delay": 60
          }
        ]
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "MONITORING_QUEUE",
        "queue": "cybrguard-monitoring-local"
      }
    ],
    "consumers": [
      {
        "queue": "cybrguard-monitoring-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
