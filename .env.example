# Server-only secrets. Copy to ignored .env; never put these in the iOS app.
# npm run dev:setup copies these to the private apps/api/.dev.vars file.
XON_API_KEY=
# Deployment token: Account Workers Scripts Edit + D1 Edit;
# Zone Workers Routes Edit + Zone Read + DNS Edit for cybrguard.app.
CLOUDFLARE_API_TOKEN=
# Comma-separated staging testers; stored as a Worker secret.
STAGING_ALLOWED_EMAILS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
EMAIL_FROM=security@cybrguard.app
# Cloudflare token must have Email Sending permission for the intended account.
# The domain must be active and enabled for outbound Email Service, not just Routing.
# Server-only RevenueCat secret API key and full webhook Authorization header.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_APP_ID=
# Modern v2 keys also require the project and internal cybrguard_pro entitlement IDs.
REVENUECAT_PROJECT_ID=
REVENUECAT_PRO_ENTITLEMENT_ID=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
